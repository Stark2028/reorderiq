{
  "name": "reorderiq-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src *.ts index.html scripts",
    "format:check": "prettier --check src *.ts index.html scripts",
    "build": "tsc --noEmit && vite build && node scripts/package-ui.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 3010"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
